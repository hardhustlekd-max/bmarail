# Database & Server Configuration (Railway PostgreSQL)
DATABASE_URL=postgresql://user:password@host:port/dbname
PGHOST=
PGUSER=
PGPASSWORD=
PGDATABASE=
PGPORT=
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Storage (S3 / Railway Bucket / MinIO)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=auto
STORAGE_PUBLIC_DOMAIN=
S3_PUBLIC_DOMAIN=

# Optional AI / Gemini API
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_API_KEY=

# Google OAuth (Client-Side)
VITE_GOOGLE_OAUTH_CLIENT_ID=
